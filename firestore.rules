rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin Verification: user in /admins collection OR verified project owner email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email in ['abeerachandio@gmail.com', 'admin@nawabshahestate.com'])
      );
    }

    // Property Validation
    function isValidProperty(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             data.propertyType is string && data.propertyType.size() <= 50 &&
             data.purpose is string && data.purpose in ['Sale', 'Rent'] &&
             data.location is string && data.location.size() <= 250 &&
             data.price is string && data.price.size() <= 100 &&
             data.area is string && data.area.size() <= 100 &&
             data.status is string && data.status in ['Available', 'Sold', 'Rented', 'Pending'] &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             (!('features' in data) || data.features is list) &&
             (!('images' in data) || data.images is list) &&
             (!('featured' in data) || data.featured is bool);
    }

    // Inquiry Validation
    function isValidInquiry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 60 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2500 &&
             data.status in ['New', 'Contacted', 'Closed'];
    }

    // Property Request Validation
    function isValidPropertyRequest(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 60 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('requirements' in data) || (data.requirements is string && data.requirements.size() <= 2500)) &&
             data.status in ['New', 'Contacted', 'Closed'];
    }

    // 1. PROPERTIES COLLECTION
    // Public users can read properties. Only verified admins can create, update, or delete.
    match /properties/{propertyId} {
      allow read: if isValidId(propertyId);
      
      allow create: if isAdmin() && isValidId(propertyId) && isValidProperty(incoming());
      
      allow update: if isAdmin() && isValidId(propertyId) && isValidProperty(incoming());
      
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    // 2. INQUIRIES COLLECTION
    // Public users can create inquiries. Only admins can read or update status.
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      
      allow read, delete: if isAdmin();
      
      allow update: if isAdmin() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                    incoming().status in ['New', 'Contacted', 'Closed'];
    }

    // 3. PROPERTY REQUESTS COLLECTION
    // Public users can submit requests. Only admins can read or manage status.
    match /propertyRequests/{requestId} {
      allow create: if isValidId(requestId) && isValidPropertyRequest(incoming());
      
      allow read, delete: if isAdmin();
      
      allow update: if isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                    incoming().status in ['New', 'Contacted', 'Closed'];
    }

    // 4. ADMINS COLLECTION
    // Internal admin whitelist. Only admins can read.
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
